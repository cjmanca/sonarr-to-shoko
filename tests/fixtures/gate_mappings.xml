<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic gate fixture authored for shoko-sonarr-linker M4-a tests.
     Not upstream Anime-Lists data. Exercises docs/compatibility.md section 3
     semantics: split seasons, absolute "a" entries, range offsets, explicit
     pair precedence, TVDB-0 exclusion, T/O encodings, multi-episode pairs,
     collisions, season-0 rules, invalid pairs, a+offset, 101-103. -->
<anime-list>
  <anime anidbid="100" tvdbid="1000" defaulttvdbseason="1"><name>Split A Season 1</name></anime>
  <anime anidbid="101" tvdbid="1000" defaulttvdbseason="2"><name>Split B Season 2</name></anime>

  <anime anidbid="110" tvdbid="1100" defaulttvdbseason="1" episodeoffset="0">
    <name>Explicit pair beats offset</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;3-9;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="120" tvdbid="1200" defaulttvdbseason="1">
    <name>Range offset</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="2" start="1" end="10" offset="20">;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="125" tvdbid="1250" defaulttvdbseason="1" episodeoffset="1">
    <name>Range offset beats entry offset</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1" start="1" end="10" offset="0">;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="130" tvdbid="1300" defaulttvdbseason="1">
    <name>TVDB zero exclusion</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;5-0;6-7;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="140" tvdbid="1400" defaulttvdbseason="1">
    <name>Trailer and Other encodings</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;201-1;202-2;401-3;402-4;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="150" tvdbid="1500" defaulttvdbseason="1">
    <name>Multi-episode AniDB to two TVDB</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;1-1+2;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="160" tvdbid="1600" defaulttvdbseason="1">
    <name>Two AniDB parts of one TVDB</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;1-1;2-1;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="170" tvdbid="1700" defaulttvdbseason="1">
    <name>Collision A</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;4-4;</mapping>
    </mapping-list>
  </anime>
  <anime anidbid="171" tvdbid="1700" defaulttvdbseason="1">
    <name>Collision B</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;9-4;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="180" tvdbid="1800" defaulttvdbseason="1">
    <name>Unique season 0 mapping</name>
    <mapping-list>
      <mapping anidbseason="0" tvdbseason="0">;1-3;</mapping>
    </mapping-list>
  </anime>
  <anime anidbid="181" tvdbid="1800" defaulttvdbseason="2">
    <name>No season 0 claim</name>
  </anime>

  <anime anidbid="190" tvdbid="1900" defaulttvdbseason="0">
    <name>Season 0 claim A</name>
    <mapping-list>
      <mapping anidbseason="0" tvdbseason="0">;1-2;</mapping>
    </mapping-list>
  </anime>
  <anime anidbid="191" tvdbid="1900" defaulttvdbseason="0">
    <name>Season 0 claim B</name>
    <mapping-list>
      <mapping anidbseason="0" tvdbseason="0">;5-2;</mapping>
    </mapping-list>
  </anime>
  <anime anidbid="192" tvdbid="1900" defaulttvdbseason="1">
    <name>OAD-style rule never resolves season 0</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="0">;3-4;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="200" tvdbid="2000" defaulttvdbseason="a">
    <name>Absolute identity plain</name>
  </anime>

  <anime anidbid="210" tvdbid="2100" defaulttvdbseason="a">
    <name>Absolute identity with mapping list</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;1-301;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="220" tvdbid="2200" defaulttvdbseason="a" episodeoffset="3">
    <name>Absolute with offset fails closed</name>
  </anime>

  <anime anidbid="230" tvdbid="2300" defaulttvdbseason="1">
    <name>Invalid pair left multi</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1">;1+2-1;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="240" tvdbid="2400" defaulttvdbseason="1">
    <name>Unverified season-0 101 identity</name>
    <mapping-list>
      <mapping anidbseason="0" tvdbseason="0">;101-1;2-2;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="250" tvdbid="2500" defaulttvdbseason="1">
    <name>Before mappings</name>
    <before>;7-1;</before>
  </anime>

  <anime anidbid="260" tvdbid="2600" defaulttvdbseason="1" episodeoffset="-10">
    <name>Negative entry offset</name>
  </anime>

  <anime anidbid="270" tvdbid="2700" defaulttvdbseason="1">
    <name>Bounds without offset inert</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1" start="1" end="10">;1-5;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="280" tvdbid="2800" defaulttvdbseason="0">
    <name>Season 0 by season alone never resolves</name>
  </anime>

  <anime anidbid="290" tvdbid="2900" defaulttvdbseason="1">
    <name>Offset without bounds excluded</name>
    <mapping-list>
      <mapping anidbseason="1" tvdbseason="1" offset="5">;</mapping>
    </mapping-list>
  </anime>

  <anime anidbid="291" tvdbid="2910" defaulttvdbseason="1">
    <name>Unverified anidbseason 2</name>
    <mapping-list>
      <mapping anidbseason="2" tvdbseason="1">;3-3;</mapping>
    </mapping-list>
  </anime>
</anime-list>
