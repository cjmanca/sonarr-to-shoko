# Keep the build context minimal: no secrets, no caches, no host state.
# F7: .env* excluded so local credential files can never leak into the image.
.git
.gitignore
.env
.env*
.venv/
venv/
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
docs/
config.yaml
*.sqlite3
/data/
compose.example.yaml
Dockerfile
.dockerignore
